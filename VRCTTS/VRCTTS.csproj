<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VRCTTS</AssemblyName>
    <Version>2.4.0</Version>
    <Product>VRCTTS</Product>
    <Title>VRCTTS</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
    <EmbeddedResource Include="Resources\VBCABLE_Driver_Pack45.zip" />
  </ItemGroup>
</Project>

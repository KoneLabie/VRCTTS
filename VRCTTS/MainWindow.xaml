<Window x:Class="VRCTTS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCTTS" Width="520" Height="355" MinWidth="430" MinHeight="315" Background="#101720" Foreground="#EBF3F7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="BrandTitle" Text="VRCTTS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ToggleButton x:Name="QuickTtsToggle" Content="Quick TTS" Style="{StaticResource ToolbarToggle}" AutomationProperties.Name="Quick TTS phrases"/>
        <ToggleButton x:Name="AudioToggle" Content="Audio" Style="{StaticResource ToolbarToggle}" Margin="3,0,0,0" AutomationProperties.Name="Audio options"/>
        <ToggleButton x:Name="SettingsToggle" Content="Settings" Style="{StaticResource ToolbarToggle}" Margin="3,0,0,0" AutomationProperties.Name="Settings"/>
        <ToggleButton x:Name="HelpToggle" Content="?" Style="{StaticResource ToolbarToggle}" Margin="3,0,0,0" Width="28" AutomationProperties.Name="Help"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,6"><TextBlock Text="YOUR MESSAGE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="Counter" Text="0 / 144" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></Grid>
      <TextBox x:Name="MessageInput" Grid.Row="1" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="16" TextChanged="OnMessageChanged" PreviewKeyDown="OnMessageKeyDown" AutomationProperties.Name="Your message" ToolTip="Enter to speak. Shift+Enter for a new line. Escape stops speech."/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="ChatboxCheck" Content="VRChat chatbox" IsChecked="True" Checked="OnChatboxChanged" Unchecked="OnChatboxChanged"/><CheckBox x:Name="SoundCheck" Content="Chime" Margin="18,0,0,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="Enter ↵" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <Button x:Name="SpeakButton" Content="Speak + send" Background="#66DDC5" Foreground="#102A28" BorderBrush="#66DDC5" FontWeight="SemiBold" Click="OnSpeak"/>
      <Button x:Name="StopButton" Grid.Column="2" Content="Stop  Esc" Click="OnStop" IsEnabled="False"/>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="4" Text="Choose your voice in Settings." Foreground="#68DDC4" FontSize="11" TextWrapping="Wrap" Margin="1,9,1,0" MaxHeight="48" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    <Popup x:Name="AudioPopup" PlacementTarget="{Binding ElementName=AudioToggle}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=AudioToggle, Mode=TwoWay}">
      <Border Width="444" Background="#1B2430" BorderBrush="#415161" BorderThickness="1" CornerRadius="9" Padding="16" TextElement.Foreground="#EBF3F7">
        <StackPanel>
          <Grid><TextBlock Text="AUDIO ROUTING" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><Button Content="Refresh" HorizontalAlignment="Right" Padding="8,3" FontSize="10" Click="OnRefresh"/></Grid>
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="HeadphonesCheck" Content="Hear in headphones" IsChecked="True"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Volume" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="HeadphoneVolume" Width="90" Minimum="0" Maximum="1" Value="0.7" Margin="6,0,0,0" AutomationProperties.Name="Headphone volume"/></StackPanel></Grid>
          <ComboBox x:Name="HeadphoneDevice" Margin="0,7,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Headphone output device"/>
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="MicCheck" Content="Send to VRCTTS" IsChecked="True"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Volume" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="MicVolume" Width="90" Minimum="0" Maximum="1" Value="1" Margin="6,0,0,0" AutomationProperties.Name="Virtual microphone volume"/></StackPanel></Grid>
          <ComboBox x:Name="MicDevice" Visibility="Collapsed" Margin="0,7,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Virtual microphone playback device"/>
          <TextBlock x:Name="MicHint" Text="In VRChat, select VRCTTS as your microphone." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
          <TextBlock Text="Microphone controls and repair are in Settings." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="QuickTtsPopup" PlacementTarget="{Binding ElementName=QuickTtsToggle}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=QuickTtsToggle, Mode=TwoWay}">
      <Border Width="370" MaxHeight="540" Background="#1B2430" BorderBrush="#415161" BorderThickness="1" CornerRadius="9" Padding="16" TextElement.Foreground="#EBF3F7">
        <StackPanel>
          <Grid Margin="0,0,0,10"><TextBlock Text="QUICK TTS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="AddQuickPhraseButton" Content="+ Add phrase" HorizontalAlignment="Right" Padding="9,5" FontSize="11" Click="OnAddQuickPhrase"/></Grid>
          <TextBlock Text="Click a phrase to speak. Uses your Audio, chatbox, and chime settings." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="QuickPhraseList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button Content="{Binding Text}" Tag="{Binding}" Click="OnPlayQuickPhrase" Padding="10,9" HorizontalContentAlignment="Left" ToolTip="{Binding Text}" AutomationProperties.Name="{Binding Text}">
                    <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46"/></DataTemplate></Button.ContentTemplate>
                  </Button>
                  <Button Content="Edit" Tag="{Binding}" Grid.Column="1" Margin="6,0,0,0" Padding="8,5" FontSize="11" Click="OnEditQuickPhrase" AutomationProperties.Name="{Binding Text, StringFormat=Edit {0}}"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="QuickPhraseEmpty" Text="No saved phrases yet. Add your first one above." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,10" Visibility="Collapsed"/>
          <StackPanel x:Name="QuickPhraseEditor" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock x:Name="QuickPhraseEditorTitle" Text="ADD PHRASE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
            <TextBox x:Name="QuickPhraseInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="78" MaxLength="5000" PreviewKeyDown="OnQuickPhraseKeyDown" AutomationProperties.Name="Quick TTS phrase text"/>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="SaveQuickPhraseButton" Content="Save phrase" Padding="10,6" FontSize="11" Click="OnSaveQuickPhrase"/>
              <Button x:Name="CancelQuickPhraseButton" Content="Cancel" Grid.Column="1" Padding="10,6" FontSize="11" Margin="6,0,0,0" Click="OnCancelQuickPhrase"/>
              <Button x:Name="DeleteQuickPhraseButton" Content="Delete" Grid.Column="2" HorizontalAlignment="Right" Padding="10,6" FontSize="11" Click="OnDeleteQuickPhrase"/>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="QuickPhraseHint" Text="Saved on this PC. Repeat audio is cached until you close the app." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}">
      <Border Width="444" MaxHeight="650" Background="#1B2430" BorderBrush="#415161" BorderThickness="1" CornerRadius="9" Padding="16" TextElement.Foreground="#EBF3F7">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
            <CheckBox x:Name="PinCheck" Content="Keep on top" Checked="OnPinChanged" Unchecked="OnPinChanged"/>
            <CheckBox x:Name="ClearAfterCheck" Content="Clear the message after successful speech" IsChecked="True" Margin="0,11,0,15"/>
                <TextBlock Text="TTS VOICE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                <ComboBox x:Name="VoiceMode" Margin="0,7,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="OnVoiceModeChanged" AutomationProperties.Name="TTS voice"/>
                <TextBlock Text="Your last selected voice is remembered when you reopen VRCTTS." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <StackPanel x:Name="FishPanel" Margin="0,12,0,0"><TextBlock Text="Fish Audio API key" FontSize="11"/><PasswordBox x:Name="FishToken" Margin="0,4,0,8" LostFocus="OnFishTokenChanged" AutomationProperties.Name="Fish Audio API key"/><TextBlock Text="Uses the selected voice through Fish Audio’s free developer model. One Fish Audio API key works for all Fish voices. Your text is sent to Fish Audio; your key is protected by Windows." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/><WrapPanel Margin="0,9,0,0"><Button Content="Get API key" Click="OnOpenFishKeys" Padding="10,6" FontSize="11"/><Button Content="Voice page" Click="OnOpenFishVoice" Padding="10,6" FontSize="11" Margin="7,0,0,0"/></WrapPanel></StackPanel>
                <StackPanel x:Name="LazybirdPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Lazybird API key" FontSize="11"/><PasswordBox x:Name="LazybirdToken" Margin="0,4,0,8" LostFocus="OnLazybirdTokenChanged" AutomationProperties.Name="Lazybird API key"/><TextBlock Text="Hasan Piker uses Lazybird and its own API key. Speech uses your Lazybird credits, including any available free allowance. Your text is sent to Lazybird; your key is protected by Windows." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/><WrapPanel Margin="0,9,0,0"><Button Content="Get API key" Click="OnOpenLazybirdKeys" Padding="10,6" FontSize="11"/><Button Content="Voice page" Click="OnOpenLazybirdVoice" Padding="10,6" FontSize="11" Margin="7,0,0,0"/></WrapPanel></StackPanel>
                <StackPanel x:Name="JustinPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Justin uses online speech first, without an account. If the service is unavailable, VRCTTS automatically tries the original offline Justin voice installed on this PC." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="OfflineHint" Text="Checking offline fallback…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/><Button Content="Refresh offline voice" HorizontalAlignment="Left" Margin="0,9,0,0" Padding="10,6" FontSize="11" Click="OnRefreshLocalVoice"/></StackPanel>
                <Separator Margin="0,16" Background="{StaticResource Line}"/>
            <Expander x:Name="SetupExpander" Header="Microphone &amp; chatbox settings" IsExpanded="False" Expanded="OnSetupExpanded" Collapsed="OnSetupCollapsed">
              <StackPanel Margin="0,14,0,2">
                <TextBlock Text="VRCTTS MICROPHONE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="The program creates its microphone on first launch using the included signed VB-CABLE driver by VB-Audio (donationware). Approve Windows’ administrator prompt; a restart may be needed. Audio is routed automatically." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,9"/>
                <WrapPanel><Button x:Name="DriverButton" Content="Repair microphone" Click="OnSetupDriver"/><Button Content="VB-Audio / donate" Click="OnOpenVbAudio" Margin="8,0,0,0"/></WrapPanel>
                <TextBlock Text="In VRChat’s microphone settings, select VRCTTS. The driver remains installed when the app closes; the app supplies its speech." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                <Separator Margin="0,16" Background="{StaticResource Line}"/>
                <TextBlock Text="VRCHAT CHATBOX" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Enable OSC in VRChat: Action Menu → Options → OSC → Enabled. Messages go to this computer only. Other players may need to allow OSC chatboxes in their settings." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,9"/>
                <WrapPanel VerticalAlignment="Center"><TextBlock Text="OSC port" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/><TextBox x:Name="OscPort" Text="9000" Width="78" AutomationProperties.Name="VRChat OSC port"/><Button Content="Send text only" Click="OnSendTextOnly" Margin="10,0,0,0"/></WrapPanel>
              </StackPanel>
            </Expander>
            <TextBlock Text="Quick TTS phrases are saved on this PC. Drafts and speech history are not saved. Close the app to stop all speech. Version 2.4.0 · Windows x64" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
    <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpToggle}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=HelpToggle, Mode=TwoWay}">
      <Border Width="340" Background="#1B2430" BorderBrush="#415161" BorderThickness="1" CornerRadius="9" Padding="16" TextElement.Foreground="#EBF3F7">
        <StackPanel>
          <TextBlock Text="QUICK HELP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
          <TextBlock Text="Enter speaks. Shift+Enter adds a line. Escape stops speech." TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="Audio: choose your headphones and adjust the microphone volume." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
          <TextBlock Text="Quick TTS: click a saved phrase to speak instantly after its first play. Add or edit phrases without changing your draft." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
          <TextBlock Text="Settings: repair the microphone, choose the voice service, or change the OSC port." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
          <TextBlock Text="For the chatbox, enable OSC in VRChat: Action Menu → Options → OSC → Enabled." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
